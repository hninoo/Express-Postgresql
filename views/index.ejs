<%- include('partials/header.ejs'); -%>

  <div class="box" id="heading">
    <h1>
      <%= listTitle %>
    </h1>
  </div>
  <div class="box">
    <% for(let item of listItems){%>
      <div class="item">
        <form action="/delete" method="post">
          <div class="fr-tooltip">
            <input type="checkbox" onchange="this.form.submit()" name="deleteItemId" value="<%= item.id %>">
            <span class="fr-tooltip-text">Click to delete this item</span>
          </div>
        </form>

        <div id="title<%=item.id%>" class="text-content">
          <p class="text-block" data-block-id="<%=item.id%>-1" contenteditable="true">
            <%= item.title %>
          </p>
          <div class="link-controls">
            <button type="button" class="link-btn" onclick="insertLink('<%=item.id%>-1')" title="Insert link">
              🔗
            </button>
            <button type="button" class="link-btn fa-plus" onclick="addTextBlock('<%=item.id%>')" title="Add text block">
              <span>+</span>
            </button>
          </div>
        </div>

        <form class="edit" action="/edit" method="post">
          <input type="hidden" name="updatedItemId" value="<%= item.id %>">
          <input id="input<%=item.id%>" type="text" name="updatedItemTitle" value="<%= item.title %>" autocomplete="off"
            autofocus="true" hidden="true" />
          <button id="done<%=item.id%>" class="edit" type="submit" hidden><img class="icon"
              src="/assets/icons/check-solid.svg" alt="tick image"></button>
        </form>
        <div class="fr-tooltip fr-tooltip-left">
          <button id="edit<%=item.id%>" class="edit" onclick="handler('<%=item.id%>')"><img class="icon"
              src="/assets/icons/pencil-solid.svg" alt="pencil image"></button>
          <span class="fr-tooltip-text">Click to edit this item</span>
        </div>
      </div>
      <% } %>

        <form class="item" action="/add" method="post">
          <input type="text" name="newItem" placeholder="New Item" autocomplete="off" autofocus="true" />
          <div class="fr-tooltip fr-tooltip-bottom">
            <button class="add" type="submit" name="list" value=<%=listTitle %> >+</button>
            <span class="fr-tooltip-text">Add new item to your list</span>
          </div>
        </form>
  </div>

  <script>
    function handler(id) {
      document.getElementById("title" + id).setAttribute("hidden", true)
      document.getElementById("edit" + id).setAttribute("hidden", true)
      document.getElementById("done" + id).removeAttribute("hidden")
      document.getElementById("input" + id).removeAttribute("hidden")
    }

    // Track text blocks and their states
    let textBlockCounter = {};
    let textBlockStates = {};

    function initializeTextBlock(itemId) {
      if (!textBlockCounter[itemId]) {
        textBlockCounter[itemId] = 1;
        textBlockStates[itemId] = {};
      }
    }

    function addTextBlock(itemId) {
      initializeTextBlock(itemId);
      
      const textContent = document.getElementById('title' + itemId);
      const newBlockId = itemId + '-' + (++textBlockCounter[itemId]);
      
      // Create new text block
      const newBlock = document.createElement('p');
      newBlock.className = 'text-block';
      newBlock.setAttribute('data-block-id', newBlockId);
      newBlock.textContent = '文章(複数行)' + textBlockCounter[itemId];
      newBlock.contentEditable = true;
      
      // Create link control for this new block
      const linkControl = document.createElement('button');
      linkControl.type = 'button';
      linkControl.className = 'link-btn';
      linkControl.innerHTML = '🔗';
      linkControl.title = 'Insert link';
      linkControl.onclick = () => insertLink(newBlockId);
      
      // Insert before link-controls
      const linkControls = textContent.querySelector('.link-controls');
      textContent.insertBefore(newBlock, linkControls);
      
      // Add link button to controls
      const addButton = linkControls.querySelector('.fa-plus');
      linkControls.insertBefore(linkControl, addButton);
      
      // Initialize state for new block
      textBlockStates[itemId][newBlockId] = {
        hasLink: false,
        originalText: newBlock.textContent
      };
      
      console.log('Added text block:', newBlockId);
      console.log('Current state:', textBlockStates[itemId]);
    }

    function insertLink(blockId) {
      const [itemId, blockNum] = blockId.split('-');
      initializeTextBlock(itemId);
      
      const textBlock = document.querySelector(`[data-block-id="${blockId}"]`);
      if (!textBlock) {
        console.error('Text block not found:', blockId);
        return;
      }
      
      // Check if this block already has a link
      const currentState = textBlockStates[itemId][blockId];
      if (currentState && currentState.hasLink) {
        alert('This text block already has a link!');
        return;
      }
      
      // Get link URL from user
      const linkUrl = prompt('Enter link URL:');
      if (!linkUrl) return;
      
      const linkText = prompt('Enter link text:', 'Click here');
      if (!linkText) return;
      
      // Create link element
      const link = document.createElement('a');
      link.href = linkUrl;
      link.textContent = linkText;
      link.className = 'inserted-link';
      link.target = '_blank';
      
      // Insert link into text block
      textBlock.appendChild(document.createElement('br'));
      textBlock.appendChild(link);
      
      // Update state
      if (!textBlockStates[itemId][blockId]) {
        textBlockStates[itemId][blockId] = {
          originalText: textBlock.textContent
        };
      }
      textBlockStates[itemId][blockId].hasLink = true;
      
      console.log('Inserted link in block:', blockId);
      console.log('Updated state:', textBlockStates[itemId]);
      
      // This fixes the issue: properly update the state tracking
      // so that subsequent fa-plus clicks work correctly
      updateBlockStates(itemId);
    }
    
    function updateBlockStates(itemId) {
      // Refresh the state of all blocks for this item
      const textContent = document.getElementById('title' + itemId);
      const allBlocks = textContent.querySelectorAll('.text-block');
      
      if (!textBlockStates[itemId]) {
        textBlockStates[itemId] = {};
      }
      
      allBlocks.forEach(block => {
        const blockId = block.getAttribute('data-block-id');
        const hasLink = block.querySelector('.inserted-link') !== null;
        
        textBlockStates[itemId][blockId] = {
          hasLink: hasLink,
          originalText: block.textContent
        };
      });
      
      console.log('Updated all block states for item:', itemId, textBlockStates[itemId]);
    }

    // Initialize existing blocks on page load
    document.addEventListener('DOMContentLoaded', function() {
      const allTextContents = document.querySelectorAll('.text-content');
      allTextContents.forEach(content => {
        const itemId = content.id.replace('title', '');
        initializeTextBlock(itemId);
        updateBlockStates(itemId);
      });
    });
  </script>
  <%- include('partials/footer.ejs'); -%>